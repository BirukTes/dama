# Cloudflare Pages applies these rules to the static deployment.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icon-bootstrap.js
  Cache-Control: no-cache

/manifests/*
  Cache-Control: no-cache

/install/*
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
