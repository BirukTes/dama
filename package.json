{
  "name": "dama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "analyze": "tsx src/analysis/analyze.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node tests/browser-check.mjs",
    "test:appearance": "node tests/appearance-browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0"
  }
}
